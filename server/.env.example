# Server Environment Configuration
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/hazard_dashboard

# CORS Allowed Origins (comma-separated for multiple origins)
CLIENT_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Authentication (Minimum 32 characters required in production)
JWT_SECRET=your_jwt_secret_min_32_characters_here
ADMIN_EMAIL=admin_mail  
ADMIN_PASSWORD=your_secure_admin_password_min_12_chars

# External Weather API Key
OPENWEATHER_API_KEY=your_openweather_api_key

# AI Gateway (Gemini or OpenAI)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
LLM_API_KEY=your_gemini_api_key_here